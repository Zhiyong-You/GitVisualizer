<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidGitVisualizerPackage">
    <!-- 「表示 > GitVisualizer」サブメニュー -->
    <Menus>
      <Menu guid="guidGitVisualizerCmdSet" id="GitVisualizerSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidGitVisualizerCmdSet" id="GitVisualizerViewGroup" />
        <Strings>
          <ButtonText>GitVisualizer</ButtonText>
          <CommandName>GitVisualizer</CommandName>
        </Strings>
      </Menu>
    </Menus>
    <Groups>
      <!-- 「表示」メニュー内でサブメニューを置くグループ -->
      <Group guid="guidGitVisualizerCmdSet" id="GitVisualizerViewGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW" />
      </Group>
      <!-- サブメニュー内の項目グループ -->
      <Group guid="guidGitVisualizerCmdSet" id="GitVisualizerSubMenuGroup" priority="0x0100">
        <Parent guid="guidGitVisualizerCmdSet" id="GitVisualizerSubMenu" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidGitVisualizerCmdSet" id="cmdidShowWorkingChanges" priority="0x0100" type="Button">
        <Parent guid="guidGitVisualizerCmdSet" id="GitVisualizerSubMenuGroup" />
        <Strings>
          <ButtonText>変更</ButtonText>
          <CanonicalName>GitVisualizer.Changes</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidGitVisualizerCmdSet" id="cmdidShowToolWindow" priority="0x0101" type="Button">
        <Parent guid="guidGitVisualizerCmdSet" id="GitVisualizerSubMenuGroup" />
        <Strings>
          <ButtonText>リポジトリ</ButtonText>
          <CanonicalName>GitVisualizer.Repository</CanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- PackageIds.cs と一致させること -->
  <Symbols>
    <GuidSymbol name="guidGitVisualizerPackage" value="{e7b7fe4d-20e4-4d97-90ed-c4e89ae7d32e}" />

    <GuidSymbol name="guidGitVisualizerCmdSet" value="{8307c1f9-fb2c-4dcb-aac7-ed2faf09a6e6}">
      <IDSymbol name="cmdidShowToolWindow" value="0x0100" />
      <IDSymbol name="cmdidShowWorkingChanges" value="0x0101" />
      <IDSymbol name="GitVisualizerViewGroup" value="0x1020" />
      <IDSymbol name="GitVisualizerSubMenuGroup" value="0x1030" />
      <IDSymbol name="GitVisualizerSubMenu" value="0x1100" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
