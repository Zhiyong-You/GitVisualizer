<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidGitVisualizerPackage">
    <Groups>
      <Group guid="guidGitVisualizerCmdSet" id="GitVisualizerViewGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidGitVisualizerCmdSet" id="cmdidShowToolWindow" priority="0x0100" type="Button">
        <Parent guid="guidGitVisualizerCmdSet" id="GitVisualizerViewGroup" />
        <Strings>
          <ButtonText>GitVisualizer ブランチ管理</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidGitVisualizerCmdSet" id="cmdidShowWorkingChanges" priority="0x0101" type="Button">
        <Parent guid="guidGitVisualizerCmdSet" id="GitVisualizerViewGroup" />
        <Strings>
          <ButtonText>GitVisualizer 変更ファイル</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- PackageIds.cs と一致させること -->
  <Symbols>
    <GuidSymbol name="guidGitVisualizerPackage" value="{e7b7fe4d-20e4-4d97-90ed-c4e89ae7d32e}" />

    <GuidSymbol name="guidGitVisualizerCmdSet" value="{8307c1f9-fb2c-4dcb-aac7-ed2faf09a6e6}">
      <IDSymbol name="cmdidShowToolWindow" value="0x0100" />
      <IDSymbol name="cmdidShowWorkingChanges" value="0x0101" />
      <IDSymbol name="GitVisualizerViewGroup" value="0x1020" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
