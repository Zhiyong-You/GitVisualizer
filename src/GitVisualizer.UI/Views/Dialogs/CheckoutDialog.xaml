<UserControl x:Class="GitVisualizer.UI.Views.Dialogs.CheckoutDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:dialogs="clr-namespace:GitVisualizer.UI.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:CheckoutDialogViewModel}"
             d:DesignWidth="400" d:DesignHeight="200">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/GitVisualizer.UI;component/Views/Dialogs/DialogStyles.xaml" />
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="DialogRootStyle" />
    </UserControl.Style>

    <StackPanel>
        <TextBlock Style="{StaticResource DialogHeaderStyle}">
            <Run Text="切り替え先: " /><Run Text="{Binding Branch.Name, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Text="未コミットの変更:" Style="{StaticResource DialogLabelStyle}" />
        <RadioButton Content="持ち越す(競合する場合は失敗)" GroupName="Handling"
                     IsChecked="{Binding Handling, Converter={StaticResource EnumEquals}, ConverterParameter=Keep}" />
        <RadioButton Content="退避(stash)して切り替え、切り替え後に戻す" GroupName="Handling"
                     IsChecked="{Binding Handling, Converter={StaticResource EnumEquals}, ConverterParameter=Stash}" />
        <RadioButton Content="破棄して切り替える" GroupName="Handling"
                     IsChecked="{Binding Handling, Converter={StaticResource EnumEquals}, ConverterParameter=Discard}" />
        <TextBlock Text="破棄した変更は元に戻せません。" Style="{StaticResource DialogNoteStyle}" />

        <CheckBox Content="同名のローカルブランチを作成して追跡する" Margin="0,10,0,0"
                  IsChecked="{Binding CreateTrackingBranch}"
                  Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}"
                  Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />

        <StackPanel Style="{StaticResource DialogButtonPanelStyle}">
            <Button Content="チェックアウト" Command="{Binding OkCommand}" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Padding="10,2"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
            <Button Content="キャンセル" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" Padding="10,2"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
