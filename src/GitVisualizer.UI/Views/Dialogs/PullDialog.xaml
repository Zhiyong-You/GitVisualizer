<UserControl x:Class="GitVisualizer.UI.Views.Dialogs.PullDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:dialogs="clr-namespace:GitVisualizer.UI.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:PullDialogViewModel}"
             d:DesignWidth="400" d:DesignHeight="200">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/GitVisualizer.UI;component/Views/Dialogs/DialogStyles.xaml" />
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="DialogRootStyle" />
    </UserControl.Style>

    <StackPanel>
        <TextBlock Style="{StaticResource DialogHeaderStyle}">
            <Run Text="{Binding Upstream, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding BranchName, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Text="統合方法:" Style="{StaticResource DialogLabelStyle}" />
        <RadioButton Content="マージする(--no-rebase)" GroupName="Mode"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Merge}" />
        <RadioButton Content="リベースする(--rebase)" GroupName="Mode"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Rebase}" />
        <RadioButton Content="fast-forward のみ(--ff-only)" GroupName="Mode"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=FastForwardOnly}" />

        <CheckBox Content="未コミットの変更を自動で退避・復元する(--autostash)" Margin="0,10,0,0"
                  IsChecked="{Binding AutoStash}"
                  Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />

        <StackPanel Style="{StaticResource DialogButtonPanelStyle}">
            <Button Content="Pull" Command="{Binding OkCommand}" IsDefault="True" MinWidth="90" Margin="0,0,6,0" Padding="10,2"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
            <Button Content="キャンセル" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" Padding="10,2"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
