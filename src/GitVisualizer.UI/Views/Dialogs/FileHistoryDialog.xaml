<UserControl x:Class="GitVisualizer.UI.Views.Dialogs.FileHistoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:dialogs="clr-namespace:GitVisualizer.UI.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:FileHistoryViewModel}"
             d:DesignWidth="760" d:DesignHeight="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GitVisualizer.UI;component/Views/Dialogs/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 一覧の行。選択色を VS テーマに合わせる -->
            <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveTextBrushKey}}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="Selector.IsSelectionActive" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveBrushKey}}" />
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="DialogRootStyle" />
    </UserControl.Style>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource DialogHeaderStyle}">
            <Run Text="ファイル: " /><Run Text="{Binding Path, Mode=OneWay}" />
        </TextBlock>
        <TextBlock DockPanel.Dock="Top" Text="ダブルクリックで、そのコミットでの差分を表示します。" Opacity="0.75" Margin="0,0,0,6" />

        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogButtonPanelStyle}" Margin="0,10,0,0">
            <Button Content="差分を表示" Command="{Binding OpenSelectedDiffCommand}" MinWidth="90" Margin="0,0,6,0" Padding="10,2"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
            <Button Content="閉じる" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" Padding="10,2"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
        </StackPanel>

        <Border BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}"
                Background="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundBrushKey}}">
            <Grid>
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         ItemContainerStyle="{StaticResource HistoryItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         MouseDoubleClick="OnEntryMouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Commit.Subject}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ShortSha}" FontFamily="Consolas" Opacity="0.75" />
                                <TextBlock Grid.Column="1" Text="{Binding Commit.AuthorDate, StringFormat='yyyy/MM/dd HH:mm'}" Opacity="0.75" />
                                <TextBlock Grid.Column="2" Text="{Binding Commit.AuthorName}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Commit.Subject, Mode=OneWay}" />
                                    <Run Text="{Binding File.OldPath, Mode=OneWay, StringFormat='  (名前変更: {0} から)'}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding Message}" Margin="8" Opacity="0.75" TextWrapping="Wrap"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
