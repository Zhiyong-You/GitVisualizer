<UserControl x:Class="GitVisualizer.UI.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vm="clr-namespace:GitVisualizer.UI.ViewModels"
             xmlns:controls="clr-namespace:GitVisualizer.UI.Controls"
             xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="1000" d:DesignHeight="640"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             TextElement.FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             TextElement.FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}">

    <!--
      色はすべて VS テーマのリソースキー(VsBrushes / EnvironmentColors / TreeViewColors / VsResourceKeys)に
      DynamicResource でバインドしているため、ダーク/ライトの切り替えに追従する。
      固定色(#RRGGBB や Colors.*)は使わないこと。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 標準コントロールが参照するシステム色を VS テーマ色に差し替える(TreeViewItem の選択色など) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveTextColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveTextColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextColorKey}}" />

        <!-- ペイン見出し -->
        <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <!-- ペインの枠 -->
        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundBrushKey}}" />
        </Style>

        <!-- 一覧(ListView / ListBox)の共通設定 -->
        <Style x:Key="ThemedListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- 一覧の行。選択色を VS テーマに合わせるためテンプレートを差し替える -->
        <Style x:Key="ThemedListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コミット履歴の行。グラフの線が上下の行とつながるよう、上下の余白をなくす -->
        <Style x:Key="HistoryListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListItemStyle}">
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />               <!-- ツールバー -->
            <RowDefinition x:Name="BranchRow" Height="*" MinHeight="120" />
            <RowDefinition Height="0" />
            <RowDefinition x:Name="WorkingChangesRow" Height="0" />
            <RowDefinition Height="Auto" />               <!-- ステータスバー -->
        </Grid.RowDefinitions>

        <!-- ===== 上: ツールバー ===== -->
        <Border x:Name="BranchToolbar" Grid.Row="0"
                Padding="6,4"
                Background="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarGradientBrushKey}}"
                BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarToolBarBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" DataContext="{Binding Toolbar}">
                <Button Content="更新" ToolTip="リポジトリを再読み込みします"
                        Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Margin="0,0,12,0" Padding="10,2" MinWidth="60" />
                <Button Content="Fetch" Command="{Binding FetchCommand}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Margin="0,0,4,0" Padding="10,2" MinWidth="60" />
                <Button Content="Pull" Command="{Binding PullCommand}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Margin="0,0,4,0" Padding="10,2" MinWidth="60" />
                <Button Content="Push" Command="{Binding PushCommand}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Margin="0,0,12,0" Padding="10,2" MinWidth="60" />
                <TextBlock Text="ブランチ:" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarTextActiveBrushKey}}" />
                <ComboBox Width="220"
                          ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          DisplayMemberPath="Name"
                          Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
            </StackPanel>
        </Border>

        <!-- ===== 中段: ブランチ / 履歴 / 詳細 ===== -->
        <Grid x:Name="BranchPane" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="320" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <!-- 左: ブランチ TreeView -->
            <Border Grid.Column="0" Style="{StaticResource PaneBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ブランチ" Style="{StaticResource PaneHeaderStyle}" />
                    <!-- TreeView.SelectedItem は読み取り専用のため、BranchTree.SelectedBranch との連動は SelectedItemChanged(コードビハインド)で行う -->
                    <TreeView DataContext="{Binding BranchTree}"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip="クリックで履歴を表示 / ダブルクリックでチェックアウト"
                              SelectedItemChanged="OnBranchTreeSelectedItemChanged"
                              MouseDoubleClick="OnBranchTreeMouseDoubleClick"
                              Foreground="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="チェックアウト..." Command="{Binding CheckoutSelectedCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.Resources>
                            <DataTemplate x:Key="BranchItemTemplate">
                                <TextBlock x:Name="Text" Text="{Binding Name}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Text" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </TreeView.Resources>
                        <TreeViewItem Header="ローカル" IsExpanded="True"
                                      ItemsSource="{Binding LocalBranches}"
                                      ItemTemplate="{StaticResource BranchItemTemplate}" />
                        <TreeViewItem Header="リモート" IsExpanded="True"
                                      ItemsSource="{Binding RemoteBranches}"
                                      ItemTemplate="{StaticResource BranchItemTemplate}" />
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" />

            <!-- 中央: コミット履歴 ListView -->
            <Border Grid.Column="2" Style="{StaticResource PaneBorderStyle}">
                <DockPanel DataContext="{Binding CommitHistory}">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="コミット履歴" Style="{StaticResource PaneHeaderStyle}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                            <Button Content="リベース..." Command="{Binding RebaseCommand}" ToolTip="現在のブランチを選択したコミット(ブランチ)にリベースします"
                                    Margin="4,2,0,2" Padding="6,0" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                            <Button Content="チェリーピック..." Command="{Binding CherryPickCommand}" ToolTip="選択したコミットを現在のブランチに取り込みます"
                                    Margin="4,2,0,2" Padding="6,0" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                            <Button Content="メッセージ変更..." Command="{Binding RewordCommand}" ToolTip="選択したコミットのメッセージを変更します"
                                    Margin="4,2,0,2" Padding="6,0" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                        </StackPanel>
                        <!-- 表示範囲。ブランチツリーでブランチをクリックすると「選択ブランチ」に切り替わる。
                             ブランチ名は長いと省略されるため、× ボタンより後に置く -->
                        <TextBlock DockPanel.Dock="Left" Text="表示:" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,2"
                                  ItemsSource="{Binding ScopeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Scope}"
                                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
                        <Button DockPanel.Dock="Left" Content="×" Command="{Binding ShowAllCommand}" ToolTip="全ブランチの表示に戻します"
                                Margin="4,2,0,2" Padding="6,0"
                                Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}"
                                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ViewBranch.Name}" ToolTip="{Binding ViewBranch.Name}"
                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding IsBranchFiltered, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                    <!-- 列見出し(列幅は下の ItemTemplate と合わせる) -->
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,2" Opacity="0.75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="グラフ" Width="{Binding GraphColumnWidth}" MinWidth="40" />
                        <TextBlock Grid.Column="1" Text="メッセージ" />
                        <TextBlock Grid.Column="2" Text="作成者" />
                        <TextBlock Grid.Column="3" Text="日時" />
                        <TextBlock Grid.Column="4" Text="SHA" />
                    </Grid>
                    <ListView ItemsSource="{Binding Commits}"
                              SelectedItem="{Binding SelectedRow}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Style="{StaticResource ThemedListStyle}"
                              ItemContainerStyle="{StaticResource HistoryListItemStyle}">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="このコミットにリベース..." Command="{Binding RebaseCommand}" />
                                <MenuItem Header="チェリーピック..." Command="{Binding CherryPickCommand}" />
                                <MenuItem Header="コミットメッセージを変更..." Command="{Binding RewordCommand}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <controls:CommitGraphCell Grid.Column="0" Height="22" MinWidth="40" Node="{Binding Node}"
                                                              Highlight="{Binding DataContext.GraphHighlight, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                              Width="{Binding DataContext.GraphColumnWidth, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- ブランチ・タグ名 -->
                                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Refs}"
                                                      Visibility="{Binding HasRefs, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,4,0" Padding="4,0" CornerRadius="2" BorderThickness="1"
                                                            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                                            Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
                                                        <TextBlock Text="{Binding}" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AuthorName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding AuthorDate, StringFormat='yyyy/MM/dd HH:mm'}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding ShortSha}" VerticalAlignment="Center" FontFamily="Consolas" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource SplitterStyle}" />

            <!-- 右: コミット詳細 -->
            <Border Grid.Column="4" Style="{StaticResource PaneBorderStyle}">
                <DockPanel DataContext="{Binding CommitDetail}">
                    <TextBlock DockPanel.Dock="Top" Text="コミット詳細" Style="{StaticResource PaneHeaderStyle}" />
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                        <TextBlock Text="{Binding Commit.Subject}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Commit.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.75">
                            <Run Text="{Binding Commit.AuthorName, Mode=OneWay}" />
                            <Run Text="&lt;" /><Run Text="{Binding Commit.AuthorEmail, Mode=OneWay}" /><Run Text="&gt;" />
                        </TextBlock>
                        <TextBlock Text="{Binding Commit.AuthorDate, StringFormat='yyyy/MM/dd HH:mm:ss'}" Opacity="0.75" />
                        <TextBox Text="{Binding Commit.Sha, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0"
                                 Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="変更ファイル" Style="{StaticResource PaneHeaderStyle}" />
                    <ListBox ItemsSource="{Binding Files}"
                             Style="{StaticResource ThemedListStyle}"
                             ItemContainerStyle="{StaticResource ThemedListItemStyle}"
                             MouseDoubleClick="OnCommitFileMouseDoubleClick"
                             KeyDown="OnCommitFileKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="差分を表示"
                                          Command="{Binding OpenDiffCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="80" Text="{Binding Kind}" Opacity="0.75" />
                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding OldPath}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border x:Name="WorkingChangesToolbar" Grid.Row="0" Visibility="Collapsed" Padding="6,4"
                Background="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarGradientBrushKey}}">
            <Button Content="更新" ToolTip="リポジトリを再読み込みします"
                    Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                    Padding="10,2" MinWidth="60" />
        </Border>

        <!-- ===== 下: 変更ファイル一覧 + コミット入力 ===== -->
        <Grid x:Name="WorkingChangesPane" Grid.Row="3" DataContext="{Binding WorkingChanges}">
			<Grid.Resources>
				<CollectionViewSource x:Key="GroupedWorkingChanges"
									  Source="{Binding Changes}">
					<CollectionViewSource.GroupDescriptions>
						<data:PropertyGroupDescription PropertyName="Kind" />
					</CollectionViewSource.GroupDescriptions>
				</CollectionViewSource>
			</Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- 左: コミット入力(上) + 変更ファイル一覧(下) -->
            <Border Grid.Column="0" Style="{StaticResource PaneBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="コミットメッセージ" Style="{StaticResource PaneHeaderStyle}" />
                    <!-- 入力に合わせて高さが伸び、MaxHeight を超えたらスクロールする -->
                    <TextBox DockPanel.Dock="Top" Margin="6,0"
                             Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="150"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                    <DockPanel DockPanel.Dock="Top" Margin="6,6,6,6" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Amend(直前のコミットを修正)" VerticalAlignment="Center"
                                  IsChecked="{Binding IsAmend}"
                                  Foreground="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}"
                                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
                        <Button DockPanel.Dock="Right" Content="Commit" Command="{Binding CommitCommand}"
                                Padding="16,2" MinWidth="80"
                                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    </DockPanel>
                    <Border DockPanel.Dock="Top" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="変更ファイル" Style="{StaticResource PaneHeaderStyle}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                            <Button Content="すべてステージ" Command="{Binding StageAllCommand}"
                                    Margin="4,2,0,2" Padding="6,0" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                            <Button Content="すべて解除" Command="{Binding UnstageAllCommand}"
                                    Margin="4,2,0,2" Padding="6,0" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                        </StackPanel>
                    </DockPanel>
					<ListView ItemsSource="{Binding Source={StaticResource GroupedWorkingChanges}}"
                              SelectedItem="{Binding SelectedChange}"
                              Style="{StaticResource ThemedListStyle}"
                              ItemContainerStyle="{StaticResource ThemedListItemStyle}"
                              MouseDoubleClick="OnWorkingFileMouseDoubleClick"
                              PreviewMouseRightButtonDown="OnWorkingFileMouseRightButtonDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="差分を表示"
                                          Command="{Binding OpenDiffCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="変更を元に戻す(Revert)" Command="{Binding RevertCommand}" />
                            </ContextMenu>
                        </ListView.ContextMenu>

						<ListView.GroupStyle>
							<GroupStyle>
								<GroupStyle.HeaderTemplate>
									<DataTemplate>
										<TextBlock Margin="4,6,4,2"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}">
											<Run Text="{Binding Name, Mode=OneWay}" />
											<Run Text=" (" />
											<Run Text="{Binding ItemCount, Mode=OneWay}" />
											<Run Text=")" />
										</TextBlock>
									</DataTemplate>
								</GroupStyle.HeaderTemplate>
							</GroupStyle>
						</ListView.GroupStyle>
						
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- チェックの切り替えでステージ / ステージ解除(git add / git restore) -->
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsStaged, Mode=OneWay}" Margin="0,0,6,0"
                                              Command="{Binding DataContext.ToggleStageCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              CommandParameter="{Binding}"
                                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding OldPath}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" />

            <!-- 変更前後を1組として表示し、チェックで即時にステージ / 解除する -->
            <Border Grid.Column="2" Style="{StaticResource PaneBorderStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{Binding ApplyLinesLabel}" Command="{Binding ApplySelectedLinesCommand}"
                                ToolTip="選択した変更前後の行の組をステージ / ステージ解除します(Shift / Ctrl で複数選択、@@ の行を選ぶとハンク全体)"
                                Margin="4,2,4,2" Padding="6,0" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                        <TextBlock Style="{StaticResource PaneHeaderStyle}" TextTrimming="CharacterEllipsis">
                            <Run Text="差分" /><Run Text="{Binding CurrentPatch.Change.Path, Mode=OneWay, StringFormat=' : {0}'}" />
                        </TextBlock>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,2" Opacity="0.75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="変更前 (−)" Margin="4,0" />
                        <TextBlock Grid.Column="2" Text="変更後 (＋)" Margin="4,0" />
                    </Grid>
                    <Grid>
                        <ListBox x:Name="DiffList"
                                 ItemsSource="{Binding DiffRows}"
                                 SelectionMode="Extended"
                                 SelectionChanged="OnDiffSelectionChanged"
                                 Style="{StaticResource ThemedListStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 FontFamily="Consolas">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding ApplyLinesLabel}" Command="{Binding ApplySelectedLinesCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListItemStyle}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiffRowViewModel}">
                                    <!--
                                      追加・削除行の背景は半透明の色を重ねる(ダーク/ライトのどちらの背景でも読めて、選択色も透けて見える)。
                                      VS テーマに差分用のリソースキーがないため、ここだけ例外として固定色を使う。
                                    -->
                                    <Grid x:Name="RowBackground" Background="Transparent" Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Margin="3,1" VerticalAlignment="Top"
                                                  IsChecked="{Binding IsStaged, Mode=OneWay}"
                                                  Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}"
                                                  ToolTip="チェックでこの行の組をステージ、チェックを外すとステージ解除"
                                                  Command="{Binding DataContext.ToggleDiffRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"
                                                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
                                        <Border x:Name="OldBackground" Grid.Column="1" Padding="2,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding OldNumber}" Opacity="0.6" TextAlignment="Right" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding OldText}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="NewBackground" Grid.Column="2" Padding="2,0" BorderThickness="1,0,0,0"
                                                BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NewNumber}" Opacity="0.6" TextAlignment="Right" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding NewText}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="HunkHeader" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding Hunk.Header}" TextWrapping="Wrap" Visibility="Collapsed" Opacity="0.7" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                            <Setter TargetName="NewBackground" Property="Background" Value="#3328A745" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                            <Setter TargetName="OldBackground" Property="Background" Value="#33D73A49" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="HunkHeader">
                                            <Setter TargetName="RowBackground" Property="Background" Value="#22808080" />
                                            <Setter TargetName="OldBackground" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="NewBackground" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="HunkHeader" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding DiffMessage}" Margin="8" TextWrapping="Wrap" Opacity="0.7"
                                   Foreground="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}"
                                   Visibility="{Binding HasDiffMessage, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 最下部: ステータスバー ===== -->
        <Border Grid.Row="4"
                Padding="6,2"
                Background="{DynamicResource {x:Static platformUI:EnvironmentColors.StatusBarDefaultBrushKey}}"
                TextElement.Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.StatusBarDefaultTextBrushKey}}">
            <DockPanel DataContext="{Binding OperationState}">
                <!-- 中断中の rebase / cherry-pick がある場合だけ表示 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsOperationInProgress, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">
                        <Run Text="{Binding OperationDisplayName, Mode=OneWay}" /><Run Text=" 中(競合を解決してステージしてから続行)" />
                    </TextBlock>
                    <Button Content="続行" Command="{Binding ContinueCommand}" Margin="0,0,4,0" Padding="8,0"
                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    <Button Content="スキップ" Command="{Binding SkipCommand}" Margin="0,0,4,0" Padding="8,0"
                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    <Button Content="中止" Command="{Binding AbortCommand}" Padding="8,0"
                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                </StackPanel>
                <ProgressBar DockPanel.Dock="Right" Width="100" Height="10" Margin="0,0,8,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ProgressBarStyleKey}}" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="ブランチ: " /><Run Text="{Binding CurrentBranchName, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
