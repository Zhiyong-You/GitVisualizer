<UserControl x:Class="GitVisualizer.UI.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vm="clr-namespace:GitVisualizer.UI.ViewModels"
             xmlns:controls="clr-namespace:GitVisualizer.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="1000" d:DesignHeight="640"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             TextElement.FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             TextElement.FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}">

    <!--
      色はすべて VS テーマのリソースキー(VsBrushes / EnvironmentColors / TreeViewColors / VsResourceKeys)に
      DynamicResource でバインドしているため、ダーク/ライトの切り替えに追従する。
      固定色(#RRGGBB や Colors.*)は使わないこと。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 標準コントロールが参照するシステム色を VS テーマ色に差し替える(TreeViewItem の選択色など) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveTextColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveTextColorKey}}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextColorKey}}" />

        <!-- ペイン見出し -->
        <Style x:Key="PaneHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <!-- ペインの枠 -->
        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundBrushKey}}" />
        </Style>

        <!-- 一覧(ListView / ListBox)の共通設定 -->
        <Style x:Key="ThemedListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- 一覧の行。選択色を VS テーマに合わせるためテンプレートを差し替える -->
        <Style x:Key="ThemedListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />               <!-- ツールバー -->
            <RowDefinition Height="*" MinHeight="120" />  <!-- ブランチ / 履歴 / 詳細 -->
            <RowDefinition Height="5" />                  <!-- スプリッター -->
            <RowDefinition Height="220" MinHeight="120" /><!-- 変更ファイル / コミット入力 -->
            <RowDefinition Height="Auto" />               <!-- ステータスバー -->
        </Grid.RowDefinitions>

        <!-- ===== 上: ツールバー ===== -->
        <Border Grid.Row="0"
                Padding="6,4"
                Background="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarGradientBrushKey}}"
                BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarToolBarBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" DataContext="{Binding Toolbar}">
                <Button Content="Fetch" Command="{Binding FetchCommand}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Margin="0,0,4,0" Padding="10,2" MinWidth="60" />
                <Button Content="Pull" Command="{Binding PullCommand}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Margin="0,0,4,0" Padding="10,2" MinWidth="60" />
                <Button Content="Push" Command="{Binding PushCommand}"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                        Margin="0,0,12,0" Padding="10,2" MinWidth="60" />
                <TextBlock Text="ブランチ:" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarTextActiveBrushKey}}" />
                <ComboBox Width="220"
                          ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          DisplayMemberPath="Name"
                          Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
            </StackPanel>
        </Border>

        <!-- ===== 中段: ブランチ / 履歴 / 詳細 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="320" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <!-- 左: ブランチ TreeView -->
            <Border Grid.Column="0" Style="{StaticResource PaneBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ブランチ" Style="{StaticResource PaneHeaderStyle}" />
                    <!-- TODO: TreeView.SelectedItem は読み取り専用のため、BranchTree.SelectedBranch との連動は SelectedItemChanged 等で実装する -->
                    <TreeView DataContext="{Binding BranchTree}"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}">
                        <TreeView.Resources>
                            <DataTemplate x:Key="BranchItemTemplate">
                                <TextBlock x:Name="Text" Text="{Binding Name}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Text" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </TreeView.Resources>
                        <TreeViewItem Header="ローカル" IsExpanded="True"
                                      ItemsSource="{Binding LocalBranches}"
                                      ItemTemplate="{StaticResource BranchItemTemplate}" />
                        <TreeViewItem Header="リモート" IsExpanded="True"
                                      ItemsSource="{Binding RemoteBranches}"
                                      ItemTemplate="{StaticResource BranchItemTemplate}" />
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" />

            <!-- 中央: コミット履歴 ListView -->
            <Border Grid.Column="2" Style="{StaticResource PaneBorderStyle}">
                <DockPanel DataContext="{Binding CommitHistory}">
                    <TextBlock DockPanel.Dock="Top" Text="コミット履歴" Style="{StaticResource PaneHeaderStyle}" />
                    <!-- 列見出し(列幅は下の ItemTemplate と合わせる) -->
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,2" Opacity="0.75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="グラフ" />
                        <TextBlock Grid.Column="1" Text="メッセージ" />
                        <TextBlock Grid.Column="2" Text="作成者" />
                        <TextBlock Grid.Column="3" Text="日時" />
                        <TextBlock Grid.Column="4" Text="SHA" />
                    </Grid>
                    <ListView ItemsSource="{Binding Commits}"
                              SelectedItem="{Binding SelectedCommit}"
                              Style="{StaticResource ThemedListStyle}"
                              ItemContainerStyle="{StaticResource ThemedListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <!-- TODO: Node に CommitGraphBuilder の結果(GraphNode)をバインドする -->
                                    <controls:CommitGraphCell Grid.Column="0" Height="18" />
                                    <TextBlock Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding AuthorName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding AuthorDate, StringFormat='yyyy/MM/dd HH:mm'}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Sha}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource SplitterStyle}" />

            <!-- 右: コミット詳細 -->
            <Border Grid.Column="4" Style="{StaticResource PaneBorderStyle}">
                <DockPanel DataContext="{Binding CommitDetail}">
                    <TextBlock DockPanel.Dock="Top" Text="コミット詳細" Style="{StaticResource PaneHeaderStyle}" />
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                        <TextBlock Text="{Binding Commit.Subject}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Commit.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.75">
                            <Run Text="{Binding Commit.AuthorName, Mode=OneWay}" />
                            <Run Text="&lt;" /><Run Text="{Binding Commit.AuthorEmail, Mode=OneWay}" /><Run Text="&gt;" />
                        </TextBlock>
                        <TextBlock Text="{Binding Commit.AuthorDate, StringFormat='yyyy/MM/dd HH:mm:ss'}" Opacity="0.75" />
                        <TextBox Text="{Binding Commit.Sha, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0"
                                 Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="変更ファイル" Style="{StaticResource PaneHeaderStyle}" />
                    <ListBox ItemsSource="{Binding Files}"
                             Style="{StaticResource ThemedListStyle}"
                             ItemContainerStyle="{StaticResource ThemedListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="80" Text="{Binding Kind}" Opacity="0.75" />
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Style="{StaticResource SplitterStyle}" />

        <!-- ===== 下: 変更ファイル一覧 + コミット入力 ===== -->
        <Grid Grid.Row="3" DataContext="{Binding WorkingChanges}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PaneBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="変更ファイル" Style="{StaticResource PaneHeaderStyle}" />
                    <ListView ItemsSource="{Binding Changes}"
                              SelectedItem="{Binding SelectedChange}"
                              Style="{StaticResource ThemedListStyle}"
                              ItemContainerStyle="{StaticResource ThemedListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- TODO: ステージ/アンステージ操作(StageCommand / UnstageCommand)を割り当てる -->
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsStaged, Mode=OneWay}" IsHitTestVisible="False" Margin="0,0,6,0"
                                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
                                    <TextBlock DockPanel.Dock="Left" Width="80" Text="{Binding Kind}" Opacity="0.75" />
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" />

            <Border Grid.Column="2" Style="{StaticResource PaneBorderStyle}">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Top" Text="コミットメッセージ" Style="{StaticResource PaneHeaderStyle}" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="6,6,6,0" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Amend(直前のコミットを修正)" VerticalAlignment="Center"
                                  IsChecked="{Binding IsAmend}"
                                  Foreground="{DynamicResource {x:Static platformUI:TreeViewColors.BackgroundTextBrushKey}}"
                                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
                        <Button DockPanel.Dock="Right" Content="Commit" Command="{Binding CommitCommand}"
                                Padding="16,2" MinWidth="80"
                                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    </DockPanel>
                    <TextBox Margin="6,0"
                             Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 最下部: ステータスバー ===== -->
        <Border Grid.Row="4"
                Padding="6,2"
                Background="{DynamicResource {x:Static platformUI:EnvironmentColors.StatusBarDefaultBrushKey}}"
                TextElement.Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.StatusBarDefaultTextBrushKey}}">
            <DockPanel DataContext="{Binding OperationState}">
                <!-- 中断中の rebase / cherry-pick がある場合だけ表示 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsOperationInProgress, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">
                        <Run Text="{Binding CurrentOperation, Mode=OneWay}" /><Run Text=" 中" />
                    </TextBlock>
                    <Button Content="続行" Command="{Binding ContinueCommand}" Margin="0,0,4,0" Padding="8,0"
                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    <Button Content="スキップ" Command="{Binding SkipCommand}" Margin="0,0,4,0" Padding="8,0"
                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    <Button Content="中止" Command="{Binding AbortCommand}" Padding="8,0"
                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                </StackPanel>
                <ProgressBar DockPanel.Dock="Right" Width="100" Height="10" Margin="0,0,8,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ProgressBarStyleKey}}" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="ブランチ: " /><Run Text="{Binding CurrentBranchName, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
