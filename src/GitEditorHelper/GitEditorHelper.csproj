<Project Sdk="Microsoft.NET.Sdk">

  <!--
    コミットメッセージ変更(reword)用の補助 exe。
    GIT_SEQUENCE_EDITOR / GIT_EDITOR として git から呼ばれ、渡されたファイルを書き換える。
    GitVisualizer.Vsix の ProjectReference 経由で VSIX のルートに同梱される。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>GitEditorHelper</RootNamespace>
  </PropertyGroup>

</Project>
